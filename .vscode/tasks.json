{
    "tasks": [
        {
            "label": "CMake: configure (Release, Ninja)",
            "type": "shell",
            "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: build neuracpp",
            "type": "shell",
            "command": "cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "dependsOn": "CMake: configure (Release, Ninja)",
            "problemMatcher": "$gcc"
        }
    ],
    "version": "2.0.0"
}
